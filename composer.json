{
    "name": "tz1/pure-php-blog",
    "description": "Clean PHP Blog with Smarty, MySQL, Redis, Admin Panel and pure PHP architecture",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "predis/predis": "^2.2",
        "smarty/smarty": "^5.4"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    }
}
